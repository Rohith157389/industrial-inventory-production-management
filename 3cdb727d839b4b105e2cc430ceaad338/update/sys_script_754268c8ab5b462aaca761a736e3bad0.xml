        <script><![CDATA[(function executeRule(current, previous) {
    var batchId = current.getValue('input_batch');
    if (!batchId) { return; }
    var batch = new GlideRecord('x_2056099_indust_0_inv_batch');
    if (batch.get(batchId)) {
        var qualityStatus = batch.getValue('quality_status');
        var batchStatus = batch.getValue('status');
        if (qualityStatus !== 'passed' || batchStatus !== 'active') {
            gs.addErrorMessage('Only QC-approved active batches can be used in production. Batch quality_status: ' + qualityStatus + ', status: ' + batchStatus);
            current.setAbortAction(true);
        }
    }
})(current, previous);]]></script>
