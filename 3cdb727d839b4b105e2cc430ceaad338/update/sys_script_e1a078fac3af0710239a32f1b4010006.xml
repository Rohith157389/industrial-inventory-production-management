        <collection>x_2056099_indust_0_prod_sched</collection>
        <condition/>
        <description>Automatically recalibrates production resource efficiency and run-rate parameters using ScheduleCalibrationEngine whenever a production schedule step reaches 'completed' status.</description>
        <execute_function>false</execute_function>
        <filter_condition table="x_2056099_indust_0_prod_sched">status=completed^EQ<item endquery="false" field="status" goto="false" newquery="false" operator="=" or="false" value="completed"/>
            <item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/>
        </filter_condition>
        <is_rest>false</is_rest>
        <message/>
        <name>Auto-Calibrate Schedule On Completion</name>
        <order>200</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous) {
    if (previous && previous.getValue('status') === 'completed') {
        return; // Already completed, avoid redundant recalibrations
    }

    var resourceSysId = current.getValue('production_resource');
    if (!resourceSysId) return;

    try {
        var engine = new x_2056099_indust_0.ScheduleCalibrationEngine();
        var calResult = engine.calibrate(resourceSysId);
        if (calResult.success) {
            gs.info('Auto-Calibrate: Resource ' + resourceSysId + ' efficiency updated from ' +
                    calResult.old_efficiency + '% to ' + calResult.new_efficiency + '%');
        }
    } catch (e) {
        gs.warn('Auto-Calibrate Error: ' + e.message);
    }
})(current, previous);]]></script>
