        <condition/>
        <description>Auto-sets return_required and actual_return_pending based on material_type (returnable_tool vs consumable/lubricant).</description>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
        <message/>
        <name>Set Return Required Based on Material Ty</name>
        <order>50</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function() {
    var materialType = current.getValue('material_type');

    if (materialType === 'returnable_tool') {
        current.setValue('return_required', true);
        current.setValue('actual_return_pending', true);
    } else if (materialType === 'consumable' || materialType === 'lubricant') {
        current.setValue('return_required', false);
        current.setValue('actual_return_pending', false);
    }
    // spare_part and other: leave as user-configured
})();
]]></script>
