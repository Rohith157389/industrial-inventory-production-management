        <name>Material Intelligence</name>
        <operation_script><![CDATA[(function process(request, response) {
    // ?production_order=<sys_id or number> -> BOM x order quantity material plan; no parameter -> stock classification
    var mi = new x_2056099_indust_0.MaterialIntelligence();
    var ref = request.queryParams.production_order ? request.queryParams.production_order.toString() : '';
    if (ref) {
        var po = new GlideRecord('x_2056099_indust_0_production_order');
        if (!(po.get(ref) || po.get('number', ref))) { response.setStatus(404); response.setBody({ success: false, error: 'Production order not found: ' + ref }); return; }
        response.setBody(mi.planForOrder(po));
        return;
    }
    response.setBody(mi.classifyStock());
})(request, response);]]></operation_script>
