        <script><![CDATA[(function executeRule(current, previous) {
    var machineId = current.getValue('machine');
    if (!machineId) { return; }
    var machine = new GlideRecord('x_2056099_indust_0_machine');
    if (machine.get(machineId)) {
        var status = machine.getValue('status');
        if (status === 'under_maintenance' || status === 'broken_down' || status === 'retired' || status === 'decommissioned' || status === 'replacement_required') {
            gs.addErrorMessage('Cannot assign production step to a machine with status: ' + status + '. Machine must be available or running.');
            current.setAbortAction(true);
        }
    }
})(current, previous);]]></script>
