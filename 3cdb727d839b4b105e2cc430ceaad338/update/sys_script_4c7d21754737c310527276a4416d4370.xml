        <script><![CDATA[(function executeRule(current, previous) {
    // Approving a scenario that carries a proposal applies it (schedules and production orders are updated).
    var st = current.getValue('simulation_status');
    if (current.simulation_status.changes() && (st == 'approved' || st == 'approved_released') &&
        (current.getValue('proposal_payload') || '').indexOf('"applied":false') > -1) {
        new x_2056099_indust_0.AdaptiveRescheduler().applyScenario(current.getUniqueValue());
    }
})(current, previous);]]></script>
