    describe('ATF-DT-05: Inter-Plant Buffer Stock Rebalance', function() {
        var P = 'x_2056099_indust_0_';

        it('should verify current stock records table exists across warehouses', function() {
            var sGr = new GlideRecord(P + 'inv_stock');
            expect(sGr.isValid()).toBe(true);
        });

        it('should verify inter-facility transfer lead times table exists', function() {
            var tlt = new GlideRecord(P + 'transfer_lead_time');
            expect(tlt.isValid()).toBe(true);
        });

        it('should verify qualified supplier material lead times table exists', function() {
            var slt = new GlideRecord(P + 'supp_lead_time');
            expect(slt.isValid()).toBe(true);
        });
    });
})(outputs, steps, params, stepResult, assertEqual);</value>
