        <script><![CDATA[(function executeRule(current, previous) {
    // Hand the line to production as soon as its order is submitted (draft orders wait for submission).
    if (current.getValue('active') != '1' || current.material_product.nil() || current.customer_order.nil()) {
        return;
    }
    var status = current.customer_order.status + '';
    if (status == '' || status == 'draft' || status == 'cancelled' || status == 'rejected') {
        return;
    }
    var result = new x_2056099_indust_0.OrderToProductionSync().createForItem(current.getUniqueValue());
    if (result && !result.success) {
        gs.info('Order Line - Create Production Order: ' + result.message);
    }
})(current, previous);]]></script>
