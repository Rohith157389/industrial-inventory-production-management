        <script><![CDATA[(function executeRule(current, previous) {
    // Only run when status has just changed to simulating
    if (current.getValue('status') !== 'simulating') {
        return;
    }
    if (previous && previous.getValue('status') === 'simulating') {
        return;
    }
    var simId = current.getUniqueValue();
    var engine = new x_2056099_indust_0.FulfillmentSimulationEngine();
    engine.simulate(simId);
})(current, previous);
]]></script>
