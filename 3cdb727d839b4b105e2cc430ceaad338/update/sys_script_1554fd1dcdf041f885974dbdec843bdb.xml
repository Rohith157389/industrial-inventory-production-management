        <script><![CDATA[(function executeRule(current, previous) {
    var machineId = current.getValue('machine');
    var outputQty = parseFloat(current.getValue('output_quantity') || '0');
    if (!machineId || outputQty <= 0) { return; }
    var machine = new GlideRecord('x_2056099_indust_0_machine');
    if (machine.get(machineId)) {
        var currentTotal = parseFloat(machine.getValue('total_production_count') || '0');
        machine.setValue('total_production_count', String(currentTotal + outputQty));
        machine.setValue('current_production_count', String(outputQty));
        machine.update();
    }
})(current, previous);]]></script>
