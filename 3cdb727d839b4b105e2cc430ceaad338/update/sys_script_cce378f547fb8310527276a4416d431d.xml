        <script><![CDATA[(function executeRule(current, previous) {
    if (!current.number.nil()) {
        return;
    }
    var prefix = 'SCH-' + new GlideDateTime().getYearLocalTime() + '-';
    var last = new GlideRecord('x_2056099_indust_0_prod_sched');
    last.addQuery('number', 'STARTSWITH', prefix);
    last.orderByDesc('number');
    last.setLimit(1);
    last.query();
    var n = last.next() ? parseInt((last.getValue('number') + '').substring(prefix.length), 10) || 0 : 0;
    current.number = prefix + ('000' + (n + 1)).slice(-3);
})(current, previous);]]></script>
