        <http_method>GET</http_method>
        <name>Get Locations</name>
        <operation_script><![CDATA[(function process(request, response) {
  var locations = [];
  var gr = new GlideRecord("x_2056099_indust_0_inv_loc");
  gr.addQuery("location_type", "inventory_warehouse");
  gr.addQuery("location_id", "STARTSWITH", "WH-");
  gr.orderBy("location_id");
  gr.query();
  while (gr.next()) {
    locations.push({
      sys_id: gr.getUniqueValue(),
      location_id: gr.getValue("location_id"),
      location_name: gr.getValue("location_name"),
      city: gr.getValue("city")
    });
  }
  response.setBody({ locations: locations });
})(request, response);
]]></operation_script>
